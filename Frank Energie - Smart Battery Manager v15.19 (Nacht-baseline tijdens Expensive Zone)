        {% else %}
          {{ (now_ts + ((zone_charge_hours_needed|float(0)) * 3600)) >= (zone_cheap_end_ts|float(0)) }}
        {% endif %}

      zone_discharge_sellable_kwh: >-
        {{ ([ ((current_soc|float(0)) - (p_morning_soc|float(0))) / 100.0 * (p_bat_cap|float(0)), 0.0 ] | max) | round(3) }}

      zone_discharge_floor_reached: >-
        {{ (current_soc | float(0)) <= ((p_morning_soc | float(0)) + 1) }}

      morning_survival_limit: >-
        {% set current_h = now().hour %}
        {% if current_h < 6 or current_h >= 21 %}
          {% set survival_target = p_morning_soc | float(0) %}
          {% set is_active_morning = is_state(conf_switch, 'on') and (states(conf_target_num)|float(0) == survival_target) %}
          {% set threshold = survival_target if is_active_morning else (survival_target - 2) %}
          {% if (current_soc | float(0)) < threshold %}
            {% set deficit = survival_target - (current_soc | float(0)) %}
            {% set kwh_needed = (deficit / 100.0) * (p_bat_cap | float(0)) %}
            {% set hours_needed = (kwh_needed / (p_charge_kw | float(3.0)) * (p_safety | float(1.0))) | round(0, 'ceil') | int %}
            {% set hours_needed = [hours_needed, 1] | max %}
            {% set today_date = now().strftime('%Y-%m-%d') %}
            {% set today_6am = as_timestamp(today_date ~ ' 06:00:00') %}
            {% set target_6am = (today_6am + 86400) if current_h >= 6 else today_6am %}
            {% set ns = namespace(prices=[]) %}
            {% for item in filtered_data.slots %}
              {% if item.ts < target_6am %}
                {% set ns.prices = ns.prices + [item.price | float(0)] %}
              {% endif %}
            {% endfor %}
            {% set sorted_night = ns.prices | sort %}
            {% if sorted_night | length > 0 %}
              {% set idx = (hours_needed - 1) if (hours_needed - 1) < sorted_night|length else (sorted_night|length - 1) %}
              {{ sorted_night[idx] }}
            {% else %} -999.0 {% endif %}
          {% else %} -999.0 {% endif %}
        {% else %} -999.0 {% endif %}

      charge_limit_strict: >-
        {% set deficit = (dynamic_target_soc | float(0)) - (current_soc | float(0)) %}
        {% if deficit > 0 %}
          {% set kwh_needed = (deficit / 100.0) * (p_bat_cap | float(0)) %}
          {% set net_kwh_needed = kwh_needed - (effective_solar_rem | float(0)) %}
          {% if net_kwh_needed > 0 %}
            {% set hours_needed = (net_kwh_needed / (p_charge_kw | float(3.0)) * (p_safety | float(1.0))) | round(0, 'ceil') | int %}
            {% set hours_needed = [hours_needed, 1] | max %}
            {% if sorted_all | length > 0 %}
              {% set idx = (hours_needed - 1) if (hours_needed - 1) < sorted_all|length else (sorted_all|length - 1) %}
              {{ sorted_all[idx] }}
            {% else %} -999.0 {% endif %}
          {% else %} -999.0 {% endif %}
        {% else %} -999.0 {% endif %}

      active_target_soc: >-
        {% set is_morning_charge = (morning_survival_limit | float(-999.0)) != -999.0 and ((current_price | float(0.0)) | round(3) <= (morning_survival_limit | float(0.0)) | round(3)) and ((current_soc | float(0.0)) < ((p_morning_soc | float(0.0)) - 0.1)) %}
        {% set normal_strict = (charge_limit_strict | float(-999.0)) != -999.0 and ((current_price | float(0.0)) | round(3) <= (charge_limit_strict | float(0.0)) | round(3)) and not solar_charging_override %}
        {% set normal_buffer = ((current_price | float(0.0)) | round(3) <= (buffer_limit | float(0.0)) | round(3)) and not solar_charging_override %}
        {% if normal_strict or normal_buffer %}
          {{ dynamic_target_soc | float(0) }}
        {% elif is_morning_charge %}
          {{ p_morning_soc | float(0) }}
        {% else %}
          {{ dynamic_target_soc | float(0) }}
        {% endif %}

      discharge_start_price: >-
        {% set base_margin_price = (last_paid_price | float(0)) * (1 + ((p_min_discharge|float(0)) / 100)) %}
        {% set virtual_soc = current_soc | float(0) %}
        {% if is_state(conf_switch, 'off') and (current_soc | float(0)) > ((p_min_base_soc | float(0)) + 1) %}
          {% set virtual_soc = (current_soc | float(0)) + 2.0 %}
        {% endif %}
        {% set usable_soc = virtual_soc - (p_min_base_soc | float(0)) %}
        {% if usable_soc > 0 %}
          {% set ns = namespace(hours_to_charge=8) %}
          {% set limit_strict = charge_limit_strict | float(0) %}
          {% set limit_buffer = buffer_limit | float(0) %}
          {% for item in filtered_data.slots[:8] %}
            {% if (item.price | float(0)) <= limit_strict or (item.price | float(0)) <= limit_buffer %}
              {% if loop.index0 < ns.hours_to_charge %}
                {% set ns.hours_to_charge = loop.index0 %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {% set horizon = [ns.hours_to_charge, 1] | max %}
          {% set kwh_avail = (usable_soc / 100.0) * (p_bat_cap | float(0)) %}
          {% set h = now().hour %}
          {% set ns2 = namespace(rem=kwh_avail, hours=0) %}
          {% for i in range(h, h + 24) %}
            {% if ns2.rem > 0 %}
              {% set hd = i % 24 %}
              {% set load = (val_night | float(0)) if hd < 6 else ((val_morning | float(0)) if hd < 9 else ((val_day | float(0)) if hd < 17 else (val_evening | float(0)))) %}
              {% set ns2.rem = ns2.rem - load %}
              {% set ns2.hours = ns2.hours + 1 %}
            {% endif %}
          {% endfor %}
          {% set hours_to_empty = [ns2.hours, 1] | max %}
          {% set active_slots = filtered_data.slots[:horizon] | map(attribute='price') | list %}
          {% set reverse_sorted = active_slots | sort(reverse=True) %}
          {% set lookahead_len = reverse_sorted | length %}
          {% if lookahead_len > 0 %}
            {% set allowed_hours = [hours_to_empty, lookahead_len] | min %}
            {% set optimal_price = reverse_sorted[allowed_hours - 1] | float(0) %}
            {% set raw_discharge = [base_margin_price, optimal_price] | max %}
          {% else %}
            {% set raw_discharge = base_margin_price %}
          {% endif %}
        {% else %}
          {% set raw_discharge = base_margin_price %}
        {% endif %}
        {% set active_charge_limit = [charge_limit_strict | float(-999.0), morning_survival_limit | float(-999.0)] | max %}
        {% if active_charge_limit != -999.0 %}
          {{ [raw_discharge, (active_charge_limit + 0.01)] | max | round(4) }}
        {% else %}
          {{ raw_discharge | round(4) }}
        {% endif %}

      feed_in_start_price: >-
        {% set peak_bypass = (relevant_peak_price | float(0)) * 0.85 %}
        {% set discharge_bypass = (discharge_start_price | float(0)) * 0.85 %}
        {{ [peak_bypass, discharge_bypass] | max | round(3) }}

  - if:
      - condition: template
        value_template: "{{ conf_disable_bypass != [] and is_state(conf_disable_bypass, 'on') and (current_soc | float(0)) >= 95 }}"
    then:
