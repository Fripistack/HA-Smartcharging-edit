        then:
          - domain: mobile_app
            type: notify
            device_id: !input notify_device
            message: "Batterij heeft 95% bereikt. Bypass-blokkade automatisch uitgeschakeld. Algoritme actief!"

  - choose:
      - alias: "1. Send Report"
        conditions:
          - condition: trigger
            id: "report"
        sequence:
          - if:
              - condition: template
                value_template: "{{ has_notify_device }}"
            then:
              - domain: mobile_app
                type: notify
                device_id: !input notify_device
                message: >-
                  {% if language == 'nl' %}
                    Dayround Status
                    SoC: {{ current_soc }}% | Inkoop: EUR{{ last_paid_price | float(0) | round(3) }}
                    Huidig: EUR{{ current_price | float(0) | round(3) }}
                    Drempels:
                    Strikt: EUR{{ charge_limit_strict | float(0) | round(3) }}
                    Morning: EUR{{ morning_survival_limit | float(0) | round(3) }}
                    Feed-In Bypass: EUR{{ feed_in_start_price | float(0) | round(3) }}
                    Verkoopgrens: EUR{{ discharge_start_price | float(0) | round(3) }}
                    Netto zon resterend: {{ effective_solar_rem | float(0) | round(2) }} kWh
                    (Profiel: {{ current_load_kw | float(0) }} kW afname nu)
                    {% if conf_cheap_period != [] or conf_expensive_period != [] %}
                    Zone-modus: {{ 'CHEAP ZONE actief' if is_cheap_zone else ('EXPENSIVE ZONE actief' if is_expensive_zone else 'buiten zone (Smart actief)') }}
                    {% if is_cheap_zone %}
                    Nog benodigd tot vol: {{ zone_charge_hours_needed }}u netladen ({{ zone_charge_net_kwh_needed }} kWh)
                    {% endif %}
                    {% if is_expensive_zone %}
                    Nog te verkopen tot nacht-baseline ({{ p_morning_soc }}%): {{ zone_discharge_sellable_kwh }} kWh
                    {% endif %}
                    {% endif %}
                  {% else %}
                    Status: {{ current_soc }}%
                    Net solar remaining: {{ effective_solar_rem | float(0) | round(2) }} kWh
                  {% endif %}

      - alias: "2. Boost Mode"
        conditions:
          - condition: template
            value_template: "{{ is_boost_active }}"
        sequence:
          - service: number.set_value
            target: {entity_id: !input target_soc_number}
            data: {value: 100}
          - service: switch.turn_on
            target: {entity_id: !input battery_reserve_switch}
          - if:
              - condition: template
                value_template: "{{ conf_tou != [] }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input time_of_use_switch}
          - if:
              - condition: template
                value_template: "{{ conf_feed_in != [] }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input feed_in_switch}

      - alias: "3. Emergency Charge"
        conditions:
          - condition: template
            value_template: >-
              {% set target = states(conf_target_num)|float(0) %}
              {% set is_active_emerg = is_state(conf_switch, 'on') and (target == ((p_min_base_soc | float(0)) + 2)) %}
              {% set threshold = ((p_min_base_soc | float(0)) + 2) if is_active_emerg else (p_min_base_soc | float(0)) %}
              {{ (current_soc | float(0)) < threshold }}
          - condition: template
            value_template: "{{ (current_price | float(0)) < ((p_max_cap | float(0)) * 1.5) }}"
        sequence:
          - variables:
              was_off: "{{ is_state(conf_switch, 'off') }}"
          - if:
              - condition: template
                value_template: "{{ (states(conf_target_num)|float(0) - ((p_min_base_soc|float(0)) + 2))|abs > 0.1 }}"
            then:
              - service: number.set_value
                target: {entity_id: !input target_soc_number}
                data: {value: "{{ (p_min_base_soc | float(0)) + 2 }}"}
          - if:
              - condition: template
                value_template: "{{ conf_feed_in != [] }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input feed_in_switch}
          - if:
              - condition: template
                value_template: "{{ was_off }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input battery_reserve_switch}
              - if:
                  - condition: template
                    value_template: "{{ conf_tou != [] }}"
                then:
                  - service: switch.turn_on
                    target: {entity_id: !input time_of_use_switch}
              - if:
                  - condition: template
                    value_template: "{{ has_notify_device }}"
                then:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    message: "Noodladen gestart (EUR{{ current_price | float(0) | round(3) }})"

      - alias: "3.5 Zone Charging (Cheap Period)"
        conditions:
          - condition: template
            value_template: "{{ is_cheap_zone }}"
          - condition: template
            value_template: "{{ not is_zero_export_window }}"
        sequence:
          - variables:
              was_off: "{{ is_state(conf_switch, 'off') }}"
              tou_was_off: "{{ conf_tou != [] and is_state(conf_tou, 'off') }}"
              tou_was_on: "{{ conf_tou != [] and is_state(conf_tou, 'on') }}"
          - if:
              - condition: template
                value_template: "{{ (states(conf_target_num)|float(0) - 100)|abs > 0.1 }}"
            then:
              - service: number.set_value
                target: {entity_id: !input target_soc_number}
                data: {value: 100}
          - if:
              - condition: template
                value_template: "{{ conf_feed_in != [] }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input feed_in_switch}
          - if:
              - condition: template
                value_template: "{{ was_off }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input battery_reserve_switch}
              - if:
                  - condition: template
                    value_template: "{{ has_notify_device }}"
                then:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    message: >-
                      {% if language == 'nl' %}
                        Cheap Zone gestart: accu bereidt zich voor op vol laden (doel SoC 100%), nog
                        {{ zone_charge_hours_needed }}u netladen verwacht nodig te zijn.
                      {% else %}
                        Cheap zone started: battery preparing to fully charge (target SoC 100%), estimated
                        {{ zone_charge_hours_needed }}h of grid charging still needed.
                      {% endif %}
          - if:
              - condition: template
                value_template: "{{ zone_charge_should_start_now and tou_was_off }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input time_of_use_switch}
              - if:
                  - condition: template
                    value_template: "{{ has_notify_device }}"
                then:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    message: >-
                      {% if language == 'nl' %}
                        Vol vermogen laden (PV+grid) gestart (EUR{{ current_price | float(0) | round(3) }}) —
                        laatst mogelijke moment om op tijd vol te zijn.
                      {% else %}
                        Full power charging (PV+grid) started (EUR{{ current_price | float(0) | round(3) }}) —
                        last possible moment to finish in time.
                      {% endif %}
          - if:
              - condition: template
                value_template: "{{ not zone_charge_should_start_now and tou_was_on }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input time_of_use_switch}

      - alias: "3.6 Zone Discharging (Expensive Period)"
        conditions:
          - condition: template
            value_template: "{{ is_expensive_zone }}"
          - condition: template
            value_template: "{{ not zone_discharge_floor_reached }}"
        sequence:
          - variables:
              was_on: "{{ is_state(conf_switch, 'on') }}"
          - if:
              - condition: template
                value_template: "{{ conf_feed_in != [] and is_state(conf_feed_in, 'off') }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input feed_in_switch}
          - if:
              - condition: template
                value_template: "{{ was_on }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input battery_reserve_switch}
              - if:
                  - condition: template
                    value_template: "{{ conf_tou != [] }}"
                then:
                  - service: switch.turn_off
                    target: {entity_id: !input time_of_use_switch}
              - if:
                  - condition: template
                    value_template: "{{ has_notify_device }}"
                then:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    message: >-
                      {% if language == 'nl' %}
                        Expensive Zone actief: batterij verkoopt nu (Feed-In Priority aan). Nog
                        {{ zone_discharge_sellable_kwh }} kWh te verkopen tot de nacht-baseline ({{ p_morning_soc }}%).
                      {% else %}
                        Expensive zone active: battery selling now (Feed-In Priority on). {{ zone_discharge_sellable_kwh }}
                        kWh left to sell before hitting the overnight baseline ({{ p_morning_soc }}%).
                      {% endif %}

      - alias: "3.65 Zone Discharge Hold (Nacht-baseline bereikt)"
        conditions:
          - condition: template
            value_template: "{{ is_expensive_zone }}"
          - condition: template
            value_template: "{{ zone_discharge_floor_reached }}"
        sequence:
          - variables:
              was_off: "{{ is_state(conf_switch, 'off') }}"
              feed_in_was_on: "{{ conf_feed_in != [] and is_state(conf_feed_in, 'on') }}"
          - if:
              - condition: template
                value_template: "{{ feed_in_was_on }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input feed_in_switch}
          - if:
              - condition: template
                value_template: "{{ was_off }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input battery_reserve_switch}
              - if:
                  - condition: template
                    value_template: "{{ has_notify_device }}"
                then:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    message: >-
                      {% if language == 'nl' %}
                        Nacht-baseline bereikt tijdens Expensive Zone ({{ p_morning_soc }}%). Verkopen gestopt,
                        batterij vastgezet voor de nacht.
                      {% else %}
                        Overnight baseline reached during Expensive Zone ({{ p_morning_soc }}%). Selling
                        stopped, battery locked for the night.
                      {% endif %}
          - if:
              - condition: template
                value_template: >-
                  {% set target = states(conf_target_num)|float(0) %}
                  {{ (target - (current_soc|float(0))) > 2 or ((current_soc|float(0)) - target) >= (p_lock_step|float(0)) }}
            then:
              - service: number.set_value
                target: {entity_id: !input target_soc_number}
                data: {value: "{{ current_soc | int }}"}

      - alias: "4. Smart Charging"
        conditions:
          - condition: template
            value_template: "{{ not is_cheap_zone and not is_expensive_zone }}"
          - condition: template
            value_template: "{{ not is_zero_export_window }}"
          - condition: or
            conditions:
              - condition: and
                conditions:
                  - condition: template
                    value_template: "{{ (morning_survival_limit | float(-999.0)) != -999.0 }}"
                  - condition: template
                    value_template: "{{ (current_price | float(0.0)) | round(3) <= (morning_survival_limit | float(0.0)) | round(3) }}"
                  - condition: template
                    value_template: "{{ (current_soc | float(0.0)) < ((p_morning_soc | float(0.0)) - 0.1) }}"
                  - condition: template
                    value_template: "{{ (current_price | float(0.0)) < (p_max_cap | float(0.0)) }}"
                  - condition: template
                    value_template: "{{ (current_price | float(0.0)) | round(3) < (discharge_start_price | float(0.0)) | round(3) }}"
              - condition: and
                conditions:
                  - condition: template
                    value_template: "{{ (charge_limit_strict | float(-999.0)) != -999.0 }}"
                  - condition: template
                    value_template: "{{ (current_price | float(0.0)) | round(3) <= (charge_limit_strict | float(0.0)) | round(3) }}"
                  - condition: template
                    value_template: "{{ (current_soc | float(0.0)) < ((dynamic_target_soc | float(0.0)) - 1) }}"
                  - condition: template
                    value_template: "{{ (current_price | float(0.0)) < (p_max_cap | float(0.0)) }}"
                  - condition: template
                    value_template: "{{ not solar_charging_override }}"
                  - condition: template
                    value_template: "{{ (current_price | float(0.0)) | round(3) < (discharge_start_price | float(0.0)) | round(3) }}"
              - condition: and
                conditions:
                  - condition: template
                    value_template: "{{ (current_price | float(0.0)) | round(3) <= (buffer_limit | float(0.0)) | round(3) }}"
                  - condition: template
                    value_template: "{{ (current_soc | float(0.0)) < ((dynamic_target_soc | float(0.0)) - 1) }}"
                  - condition: template
                    value_template: "{{ (current_price | float(0.0)) < (p_max_cap | float(0.0)) }}"
                  - condition: template
                    value_template: "{{ not solar_charging_override }}"
                  - condition: template
                    value_template: "{{ (current_price | float(0.0)) | round(3) < (discharge_start_price | float(0.0)) | round(3) }}"
        sequence:
          - variables:
              was_off: "{{ is_state(conf_switch, 'off') }}"
          - if:
              - condition: template
                value_template: "{{ (states(conf_target_num)|float(0) - (active_target_soc|float(0)))|abs > 0.1 }}"
            then:
              - service: number.set_value
                target: {entity_id: !input target_soc_number}
                data: {value: "{{ active_target_soc | float(0) }}"}
          - if:
              - condition: template
                value_template: "{{ conf_feed_in != [] }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input feed_in_switch}
          - if:
              - condition: template
                value_template: "{{ was_off }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input battery_reserve_switch}
              - if:
                  - condition: template
                    value_template: "{{ conf_tou != [] }}"
                then:
                  - service: switch.turn_on
                    target: {entity_id: !input time_of_use_switch}
              - if:
                  - condition: template
                    value_template: "{{ has_notify_device }}"
                then:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    message: "Start Laden (EUR{{ current_price | float(0) | round(3) }})"

      - alias: "5. Discharging"
        conditions:
          - condition: template
            value_template: "{{ not is_cheap_zone and not is_expensive_zone }}"
          - condition: template
            value_template: "{{ (current_soc | float(0)) > ((p_min_base_soc | float(0)) + 1) }}"
          - condition: template
            value_template: >-
              {% if is_state(conf_switch, 'off') %}
                {{ (current_price | float(0.0)) | round(3) >= ((discharge_start_price | float(0.0)) - 0.02) | round(3) }}
              {% else %}
                {{ (current_price | float(0.0)) | round(3) >= (discharge_start_price | float(0.0)) | round(3) }}
              {% endif %}
          - condition: template
            value_template: "{{ (current_price | float(0.0)) | round(3) > (buffer_limit | float(0.0)) | round(3) }}"
        sequence:
          - variables:
              was_on: "{{ is_state(conf_switch, 'on') }}"
          - if:
              - condition: template
                value_template: "{{ conf_feed_in != [] }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input feed_in_switch}
          - if:
              - condition: template
                value_template: "{{ was_on }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input battery_reserve_switch}
              - if:
                  - condition: template
                    value_template: "{{ conf_tou != [] }}"
                then:
                  - service: switch.turn_off
                    target: {entity_id: !input time_of_use_switch}
              - if:
                  - condition: template
                    value_template: "{{ has_notify_device }}"
                then:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    message: "Start Ontladen (EUR{{ current_price | float(0) | round(3) }})"

      - alias: "5.5. Solar Bypass (Feed-In Priority)"
        conditions:
          - condition: template
            value_template: "{{ not is_cheap_zone and not is_expensive_zone }}"
          - condition: template
            value_template: "{{ not is_bypass_disabled }}"
          - condition: template
            value_template: "{{ is_daytime }}"
          - condition: template
            value_template: "{{ (current_price | float(0.0)) | round(3) >= (feed_in_start_price | float(0.0)) | round(3) }}"
          - condition: template
            value_template: "{{ (current_price | float(0.0)) | round(3) < (discharge_start_price | float(0.0)) | round(3) }}"
          - condition: template
            value_template: "{{ conf_feed_in != [] }}"
        sequence:
          - variables:
              feed_in_was_off: "{{ is_state(conf_feed_in, 'off') }}"
              was_off: "{{ is_state(conf_switch, 'off') }}"
          - if:
              - condition: template
                value_template: "{{ was_off }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input battery_reserve_switch}
          - if:
              - condition: template
                value_template: "{{ conf_tou != [] }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input time_of_use_switch}
          - if:
              - condition: template
                value_template: >-
                  {% set target = states(conf_target_num)|float(0) %}
                  {{ (target - (current_soc|float(0))) > 2 or ((current_soc|float(0)) - target) >= (p_lock_step|float(0)) }}
            then:
              - service: number.set_value
                target: {entity_id: !input target_soc_number}
                data: {value: "{{ current_soc | int }}"}
          - if:
              - condition: template
                value_template: "{{ feed_in_was_off }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input feed_in_switch}
              - if:
                  - condition: template
                    value_template: "{{ has_notify_device }}"
                then:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    message: "Solar Bypass Actief. Batterij op slot, zonnestroom naar net!"

      - alias: "6. Smart Hold"
        conditions:
          - condition: template
            value_template: "{{ not is_cheap_zone and not is_expensive_zone }}"
          - condition: template
            value_template: "{{ not is_bypass_disabled }}"
          - condition: template
            value_template: "{{ not is_zero_export_window }}"
          - condition: template
            value_template: "{{ (current_price | float(0.0)) | round(3) > (charge_limit_strict | float(0.0)) | round(3) }}"
          - condition: template
            value_template: "{{ (current_price | float(0.0)) | round(3) > (morning_survival_limit | float(0.0)) | round(3) }}"
          - condition: template
            value_template: >-
              {% if is_state(conf_switch, 'off') %}
                {{ (current_price | float(0.0)) | round(3) < ((discharge_start_price | float(0.0)) - 0.02) | round(3) }}
              {% else %}
                {{ (current_price | float(0.0)) | round(3) < (discharge_start_price | float(0.0)) | round(3) }}
              {% endif %}
          - condition: template
            value_template: >-
              {% if conf_feed_in != [] and is_daytime %}
                {{ (current_price | float(0.0)) | round(3) < (feed_in_start_price | float(0.0)) | round(3) }}
              {% else %}
                true
              {% endif %}
          - condition: template
            value_template: "{{ (current_soc | float(0.0)) > (p_min_base_soc | float(0.0)) }}"
        sequence:
          - variables:
              was_off: "{{ is_state(conf_switch, 'off') }}"
          - if:
              - condition: template
                value_template: "{{ conf_feed_in != [] }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input feed_in_switch}
          - if:
              - condition: template
                value_template: "{{ was_off }}"
            then:
              - service: switch.turn_on
                target: {entity_id: !input battery_reserve_switch}
              - if:
                  - condition: template
                    value_template: "{{ conf_tou != [] }}"
                then:
                  - service: switch.turn_off
                    target: {entity_id: !input time_of_use_switch}
              - if:
                  - condition: template
                    value_template: "{{ has_notify_device }}"
                then:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    message: "Smart Hold (Wachten op Top-Prijs)"
          - if:
              - condition: template
                value_template: >-
                  {% set target = states(conf_target_num)|float(0) %}
                  {{ (target - (current_soc|float(0))) > 2 or ((current_soc|float(0)) - target) >= (p_lock_step|float(0)) }}
            then:
              - service: number.set_value
                target: {entity_id: !input target_soc_number}
                data: {value: "{{ current_soc | int }}"}

    default:
      - service: switch.turn_off
        target: {entity_id: !input battery_reserve_switch}
      - if:
          - condition: template
            value_template: "{{ conf_tou != [] }}"
        then:
          - service: switch.turn_off
            target: {entity_id: !input time_of_use_switch}
      - if:
          - condition: template
            value_template: "{{ conf_feed_in != [] }}"
        then:
          - service: switch.turn_off
            target: {entity_id: !input feed_in_switch}

  - if:
      - condition: template
        value_template: "{{ conf_return_price != [] }}"
    then:
      - choose:
          - conditions:
              - condition: template
                value_template: "{{ (current_price | float(0.0)) < 0.0 }}"
            sequence:
              - if:
                  - condition: template
                    value_template: "{{ conf_offgrid != [] and is_state(conf_offgrid, 'off') }}"
                then:
                  - service: switch.turn_on
                    target: {entity_id: !input offgrid_switch}
                  - if:
                      - condition: template
                        value_template: "{{ has_notify_device }}"
                    then:
                      - domain: mobile_app
                        type: notify
                        device_id: !input notify_device
                        message: "All-in stroomprijs negatief (EUR{{ current_price | float(0) | round(3) }}). Offgrid modus INGESCHAKELD!"
              - if:
                  - condition: template
                    value_template: "{{ conf_backflow != [] and states(conf_backflow)|float(-1) != 0.0 }}"
                then:
                  - service: number.set_value
                    target: {entity_id: !input backflow_power_entity}
                    data: {value: 0.0}

          - conditions:
              - condition: template
                value_template: "{{ (current_price | float(0.0)) >= 0.0 }}"
              - condition: template
                value_template: "{{ (current_raw_price | float(0.0)) < 0.0 }}"
            sequence:
              - if:
                  - condition: template
                    value_template: "{{ conf_offgrid != [] and is_state(conf_offgrid, 'on') }}"
                then:
                  - service: switch.turn_off
                    target: {entity_id: !input offgrid_switch}
              - if:
                  - condition: template
                    value_template: "{{ conf_backflow != [] and states(conf_backflow)|float(-1) != 0.0 }}"
                then:
                  - service: number.set_value
                    target: {entity_id: !input backflow_power_entity}
                    data: {value: 0.0}
                  - if:
                      - condition: template
                        value_template: "{{ has_notify_device }}"
                    then:
                      - domain: mobile_app
                        type: notify
                        device_id: !input notify_device
                        message: "Kale stroomprijs negatief (EUR{{ current_raw_price | float(0) | round(3) }}). Export geblokkeerd (Backflow = 0W), Offgrid UIT."

        default:
          - if:
              - condition: template
                value_template: "{{ conf_offgrid != [] and is_state(conf_offgrid, 'on') }}"
            then:
              - service: switch.turn_off
                target: {entity_id: !input offgrid_switch}
          - if:
              - condition: template
                value_template: "{{ conf_backflow != [] and states(conf_backflow)|float(-1) != (p_normal_backflow|float(0)) }}"
            then:
              - service: number.set_value
                target: {entity_id: !input backflow_power_entity}
                data: {value: "{{ p_normal_backflow | float(0) }}"}
              - if:
                  - condition: template
                    value_template: "{{ has_notify_device }}"
                then:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    message: "Stroomprijzen positief. Export vrijgegeven (Backflow = {{ p_normal_backflow }}W)."

mode: single
